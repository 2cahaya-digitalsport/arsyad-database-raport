        async function tambahSubMenuPenilaian(event) {
            event.preventDefault();
            const input = document.getElementById("input-nama-submenu-baru");
            const nama = input.value.trim();
            if (!nama) return;

            if (raportSubmenus.some(s => s.nama.toLowerCase() === nama.toLowerCase())) {
                tampilkanNotif(`Sub menu "${nama}" sudah ada.`, true);
                return;
            }

            const newId = "sub_" + Date.now();
            const listBaru = [...raportSubmenus, { id: newId, nama: nama }];

            try {
                const updates = {};
                updates["administrasi_digital/raport_submenu"] = listBaru;
                updates["administrasi_digital/raport_submenu_init"] = true;
                updates[`administrasi_digital/raport_kriteria/${newId}`] = [
                    { id: "col_" + Date.now(), nama: "Aspek Penilaian 1" }
                ];
                await database.ref().update(updates);
                input.value = "";
                tampilkanNotif(`Sub menu "${nama}" berhasil ditambahkan.`);
                pilihMenu("penilaian", newId);
            } catch (e) {
                tampilkanNotif("Gagal menambah sub menu: " + e.message, true);
            }
        }

        async function hapusSubMenuPenilaian(subId, namaSub) {
            if (raportSubmenus.length <= 1) {
                tampilkanNotif("Minimal harus tersisa 1 sub menu penilaian.", true);
                return;
            }
            if (!confirm(`Yakin ingin menghapus sub menu "${namaSub}" beserta seluruh kolom aspek di dalamnya?`)) return;

            const listBaru = raportSubmenus.filter(s => String(s.id) !== String(subId));
            try {
                const updates = {};
                updates["administrasi_digital/raport_submenu"] = listBaru;
                updates["administrasi_digital/raport_submenu_init"] = true;
                updates[`administrasi_digital/raport_kriteria/${subId}`] = null;
                await database.ref().update(updates);

                if (subKategoriAktif === subId && listBaru.length > 0) {
                    subKategoriAktif = listBaru[0].id;
                }
                tampilkanNotif(`Sub menu "${namaSub}" dihapus.`);
                if (menuAktif === "penilaian") {
                    updateTampilanKategoriPenilaian();
                }
            } catch (e) {
                tampilkanNotif("Gagal menghapus sub menu: " + e.message, true);
            }
        }

