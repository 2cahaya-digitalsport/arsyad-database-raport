<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Raport Anggota - Dangsanak Sport Club</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <!-- Font Awesome Icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- Firebase SDK (Compatibility Version) -->
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
    <script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-database-compat.js"></script>

    <style>
        html, body {
            touch-action: manipulation;
            -webkit-text-size-adjust: 100%;
        }
        body {
            font-family: ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Helvetica Neue", Arial, sans-serif;
        }
        @media (max-width: 768px) {
            input, select, textarea {
                font-size: 16px !important;
            }
        }
        .sidebar-link-active {
            background-color: #059669;
            color: #ffffff;
            box-shadow: 0 4px 12px rgba(5, 150, 105, 0.3);
        }
        .submenu-link-active {
            background-color: rgba(16, 185, 129, 0.18);
            color: #34d399;
            border-left: 3px solid #10b981;
        }
        .table-scroll {
            overflow-x: auto;
            -webkit-overflow-scrolling: touch;
        }
        ::-webkit-scrollbar {
            height: 6px;
            width: 6px;
        }
        ::-webkit-scrollbar-thumb {
            background: #cbd5e1;
            border-radius: 9999px;
        }

        /* ==================== CETAK PDF RAPORT RAPI TANPA TERPOTONG ==================== */
        #print-area {
            display: none;
        }
        @page {
            size: A4 portrait;
            margin: 10mm;
        }
        @media print {
            html, body {
                background: #ffffff !important;
                color: #0f172a !important;
                margin: 0 !important;
                padding: 0 !important;
                height: auto !important;
                min-height: 0 !important;
                overflow: visible !important;
                -webkit-print-color-adjust: exact !important;
                print-color-adjust: exact !important;
            }
            body > *:not(#print-area) {
                display: none !important;
            }
            #print-area {
                display: block !important;
                width: 100% !important;
                margin: 0 !important;
                padding: 0 !important;
            }
            .raport-page {
                width: 100%;
                box-sizing: border-box;
                border: 1.5px solid #047857;
                border-radius: 8px;
                padding: 14px 16px;
                background: #ffffff !important;
                break-inside: avoid;
                page-break-inside: avoid;
                break-after: page;
                page-break-after: always;
            }
            .raport-page:last-child {
                break-after: auto;
                page-break-after: auto;
            }
            .raport-kop {
                display: flex;
                justify-content: space-between;
                align-items: center;
                border-bottom: 2.5px solid #047857;
                padding-bottom: 8px;
                margin-bottom: 10px;
            }
            .raport-identitas {
                display: flex;
                gap: 12px;
                align-items: center;
                background: #f8fafc !important;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 8px 10px;
                margin-bottom: 10px;
            }
            .raport-foto {
                width: 54px;
                height: 68px;
                object-fit: cover;
                border-radius: 4px;
                border: 1px solid #94a3b8;
                flex-shrink: 0;
            }
            .raport-inisial {
                width: 54px;
                height: 68px;
                border-radius: 4px;
                background: #d1fae5 !important;
                color: #065f46 !important;
                font-weight: 800;
                font-size: 16pt;
                display: flex;
                align-items: center;
                justify-content: center;
                border: 1px solid #10b981;
                flex-shrink: 0;
            }
            .raport-bio-grid {
                flex: 1;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 3px 14px;
                font-size: 8.5pt;
            }
            .raport-section-title {
                background: #047857 !important;
                color: #ffffff !important;
                font-size: 8.5pt;
                font-weight: 700;
                text-transform: uppercase;
                padding: 4px 8px;
                border-radius: 4px 4px 0 0;
                display: flex;
                justify-content: space-between;
            }
            .raport-table {
                width: 100%;
                border-collapse: collapse;
                font-size: 8.2pt;
                margin-bottom: 8px;
            }
            .raport-table th,
            .raport-table td {
                border: 1px solid #94a3b8;
                padding: 3.5px 7px;
            }
            .raport-table th {
                background: #ecfdf5 !important;
                color: #065f46 !important;
                font-weight: 700;
                text-align: left;
            }
            .raport-summary {
                display: flex;
                gap: 10px;
                align-items: stretch;
                margin-top: 6px;
                margin-bottom: 12px;
            }
            .raport-nilai-box {
                width: 170px;
                border: 1.5px solid #047857;
                background: #ecfdf5 !important;
                border-radius: 6px;
                padding: 8px;
                text-align: center;
                flex-shrink: 0;
            }
            .raport-catatan-box {
                flex: 1;
                border: 1px solid #cbd5e1;
                border-radius: 6px;
                padding: 7px 10px;
                font-size: 8pt;
            }
            .raport-ttd {
                display: flex;
                justify-content: space-between;
                margin-top: 12px;
                font-size: 8.2pt;
                text-align: center;
            }
        }
    </style>
</head>
<body class="bg-slate-100 text-slate-800 antialiased min-h-screen flex">

    <!-- OVERLAY SIDEBAR (MOBILE) -->
    <div id="sidebar-overlay" onclick="setSidebar(false)" class="fixed inset-0 bg-black/60 backdrop-blur-[1px] z-40 hidden lg:hidden transition-opacity"></div>

    <!-- SIDEBAR NAVIGASI RAPORT -->
    <aside id="raport-sidebar"
        class="fixed inset-y-0 left-0 z-50 w-72 shrink-0 bg-slate-900 text-slate-200 flex flex-col justify-between shadow-2xl transition-all duration-300 ease-in-out -translate-x-full lg:sticky lg:top-0 lg:h-screen lg:translate-x-0">
        
        <div class="flex flex-col flex-1 overflow-y-auto">
            <!-- Header Sidebar -->
            <div class="px-4 py-4 bg-slate-950 border-b border-slate-800 flex items-center justify-between gap-2">
                <div class="flex items-center gap-2.5 min-w-0">
                    <div class="w-9 h-9 rounded-xl bg-emerald-600/20 border border-emerald-500/40 flex items-center justify-center text-emerald-400 shrink-0">
                        <i class="fa-solid fa-award"></i>
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-black tracking-wider text-white uppercase truncate">Raport Anggota</p>
                        <p class="text-[10px] text-slate-400 truncate">Dangsanak Sport Club</p>
                    </div>
                </div>
                <button type="button" onclick="setSidebar(false)" title="Tutup Sidebar"
                    class="lg:hidden w-8 h-8 rounded-lg bg-slate-800 hover:bg-slate-700 text-slate-400 hover:text-white flex items-center justify-center transition-colors cursor-pointer shrink-0">
                    <i class="fa-solid fa-xmark text-sm"></i>
                </button>
            </div>

            <!-- Info Panel -->
            <div class="p-4 border-b border-slate-800/80 bg-slate-900/50">
                <div class="flex items-center gap-3">
                    <div class="w-10 h-10 rounded-full bg-emerald-600 text-white flex items-center justify-center font-black text-sm border-2 border-emerald-400 shrink-0">
                        DSC
                    </div>
                    <div class="min-w-0">
                        <p class="text-xs font-bold text-white truncate">Evaluasi &amp; Penilaian</p>
                        <p class="text-[11px] text-emerald-400 font-medium truncate">
                            <i class="fa-solid fa-circle text-[8px] mr-1"></i>Sync Firebase Realtime
                        </p>
                    </div>
                </div>
            </div>

            <!-- Menu Sidebar -->
            <nav class="p-3 space-y-1.5 flex-1">
                <p class="px-3 pt-1 pb-1 text-[10px] font-bold text-slate-500 uppercase tracking-wider">Menu Raport</p>

                <!-- 1. Data Peserta -->
                <button type="button" onclick="pilihMenu('peserta')" id="nav-peserta"
                    class="sidebar-btn sidebar-link-active w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-left transition-all cursor-pointer">
                    <span class="flex items-center gap-3">
                        <i class="fa-solid fa-users w-4 text-center"></i>
                        <span>Data Peserta</span>
                    </span>
                    <span id="badge-jml-peserta" class="px-2 py-0.5 rounded-full text-[10px] font-bold bg-white/20 text-white">0</span>
                </button>

                <!-- 2. Penilaian (Parent dengan Sub Menu Dinamis) -->
                <div class="space-y-1">
                    <button type="button" onclick="toggleSubmenuPenilaian()" id="nav-penilaian"
                        class="sidebar-btn w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                        <span class="flex items-center gap-3">
                            <i class="fa-solid fa-clipboard-check w-4 text-center text-amber-400"></i>
                            <span>Penilaian</span>
                        </span>
                        <i id="chevron-penilaian" class="fa-solid fa-chevron-down text-[10px] transition-transform"></i>
                    </button>

                    <!-- Sub Menu Dinamis (Fisik, Teknik, Taktik, dll) -->
                    <div id="submenu-penilaian" class="pl-4 space-y-1">
                        <!-- Di-render otomatis via JS -->
                    </div>
                </div>

                <!-- 3. Daftar Nilai -->
                <button type="button" onclick="pilihMenu('daftar-nilai')" id="nav-daftar-nilai"
                    class="sidebar-btn w-full flex items-center justify-between gap-2 px-3.5 py-2.5 rounded-xl text-xs font-semibold text-slate-300 hover:bg-slate-800 hover:text-white text-left transition-all cursor-pointer">
                    <span class="flex items-center gap-3">
                        <i class="fa-solid fa-table-list w-4 text-center text-cyan-400"></i>
                        <span>Daftar Nilai</span>
                    </span>
                </button>
            </nav>
        </div>

        <!-- Footer Sidebar -->
        <div class="p-4 bg-slate-950 border-t border-slate-800">
            <p class="text-[10px] text-center text-slate-500">Sistem Raport Digital Anggota<br>Dangsanak Sport Club</p>
        </div>
    </aside>

    <!-- AREA KONTEN UTAMA -->
    <div class="flex-1 flex flex-col min-w-0">

        <!-- Topbar -->
        <header class="bg-emerald-700 text-white sticky top-0 z-30 shadow-md">
            <div class="px-4 sm:px-6 py-3.5 flex items-center justify-between gap-3">
                <div class="flex items-center gap-3 min-w-0">
                    <button type="button" onclick="toggleSidebar()" title="Buka / Tutup Sidebar"
                        class="w-10 h-10 rounded-xl bg-emerald-600 hover:bg-emerald-500 border border-emerald-500/40 flex items-center justify-center transition-colors shrink-0 cursor-pointer">
                        <i class="fa-solid fa-bars text-base"></i>
                    </button>
                    <div class="min-w-0">
                        <h1 id="topbar-title" class="text-sm sm:text-base font-bold truncate">Data Peserta</h1>
                        <p class="text-[11px] text-emerald-100 truncate">Raport Anggota • Dangsanak Sport Club</p>
                    </div>
                </div>

                <div class="flex items-center gap-2 shrink-0">
                    <span class="hidden sm:inline-flex items-center gap-1.5 text-[11px] font-bold bg-emerald-800/70 px-3 py-1.5 rounded-xl border border-emerald-500/30">
                        <i class="fa-solid fa-database text-emerald-300"></i> Realtime
                    </span>
                </div>
            </div>
        </header>

        <!-- Toast Notifikasi -->
        <div id="toast-notif" class="fixed bottom-4 right-4 z-[70] hidden max-w-sm bg-slate-900 text-white text-xs font-semibold px-4 py-3 rounded-xl shadow-2xl border border-slate-700 flex items-center gap-2.5">
            <i id="toast-icon" class="fa-solid fa-circle-check text-emerald-400 text-sm"></i>
            <span id="toast-text">Berhasil disimpan.</span>
        </div>

        <!-- Konten Utama -->
        <main class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 py-6 space-y-6">

            <!-- ==================== 1. MENU DATA PESERTA (TANPA TAMBAH PESERTA) ==================== -->
            <section id="sec-peserta" class="raport-section space-y-5">
                <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm flex flex-wrap items-center justify-between gap-3">
                    <div class="flex items-center gap-3">
                        <div class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                            <i class="fa-solid fa-users text-lg"></i>
                        </div>
                        <div>
                            <h2 class="text-sm sm:text-base font-bold text-slate-800">Data Peserta Terdaftar</h2>
                            <p class="text-[11px] text-slate-500">Daftar peserta terdaftar dari database untuk penilaian raport dan cetak PDF</p>
                        </div>
                    </div>
                    <span id="count-peserta-header" class="text-xs font-bold px-3.5 py-2 rounded-xl bg-emerald-50 text-emerald-700 border border-emerald-200">
                        0 Peserta Terdaftar
                    </span>
                </div>

                <div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
                    <!-- Form Edit Peserta (Hanya muncul saat tombol Edit ditekan) -->
                    <div id="box-form-peserta" class="hidden lg:col-span-1 bg-white rounded-2xl border border-amber-200 shadow-sm overflow-hidden h-fit">
                        <div class="px-5 py-4 bg-amber-50/80 border-b border-amber-100 flex items-center justify-between">
                            <h3 class="text-xs font-bold text-amber-800 uppercase tracking-wider">Edit Data Peserta</h3>
                            <button type="button" onclick="tutupFormEditPeserta()" class="text-slate-400 hover:text-slate-600 cursor-pointer"><i class="fa-solid fa-xmark"></i></button>
                        </div>
                        <form id="form-peserta" onsubmit="simpanEditPeserta(event)" class="p-4 space-y-3 text-xs">
                            <input type="hidden" id="peserta-id">
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">Nama Lengkap *</label>
                                <input type="text" id="peserta-nama" required placeholder="Nama lengkap anggota" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                            </div>
                            <div class="grid grid-cols-2 gap-2.5">
                                <div>
                                    <label class="block font-bold text-slate-600 mb-1">NIA</label>
                                    <input type="text" id="peserta-nia" placeholder="Nomor Induk" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-600 mb-1">Ranting / Rayon *</label>
                                    <input type="text" id="peserta-rayon" list="list-opsi-rayon" required placeholder="Pilih / ketik" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2.5">
                                <div>
                                    <label class="block font-bold text-slate-600 mb-1">Jenis Kelamin *</label>
                                    <select id="peserta-jk" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                                        <option value="Putra">Putra</option>
                                        <option value="Putri">Putri</option>
                                    </select>
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-600 mb-1">Kategori Usia *</label>
                                    <select id="peserta-usia" required class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                                        <option value="Usia Dini">Usia Dini</option>
                                        <option value="Pra Remaja">Pra Remaja</option>
                                        <option value="Remaja">Remaja</option>
                                        <option value="Dewasa">Dewasa</option>
                                        <option value="Pelatih">Pelatih</option>
                                        <option value="Warga">Warga</option>
                                    </select>
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2.5">
                                <div>
                                    <label class="block font-bold text-slate-600 mb-1">Tanggal Lahir</label>
                                    <input type="date" id="peserta-tgl" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                                </div>
                                <div>
                                    <label class="block font-bold text-slate-600 mb-1">Berat Badan (kg)</label>
                                    <input type="number" id="peserta-bb" min="1" max="250" step="0.1" placeholder="Contoh: 55" class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                                </div>
                            </div>
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">No. WhatsApp</label>
                                <input type="tel" id="peserta-wa" placeholder="08..." class="w-full px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                            </div>
                            <div>
                                <label class="block font-bold text-slate-600 mb-1">Pas Foto (Opsional)</label>
                                <input type="file" id="peserta-foto" accept="image/*" class="w-full text-[11px] file:mr-2 file:py-1.5 file:px-3 file:rounded-lg file:border-0 file:bg-amber-50 file:text-amber-700 file:font-bold">
                            </div>
                            <div class="flex gap-2 pt-2">
                                <button type="submit" class="flex-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2.5 rounded-xl cursor-pointer">
                                    <i class="fa-solid fa-floppy-disk mr-1"></i>Simpan Perubahan
                                </button>
                                <button type="button" onclick="tutupFormEditPeserta()" class="px-4 bg-slate-100 hover:bg-slate-200 text-slate-600 font-bold py-2.5 rounded-xl cursor-pointer">Batal</button>
                            </div>
                        </form>
                    </div>

                    <!-- Tabel Data Peserta -->
                    <div id="box-tabel-peserta" class="lg:col-span-3 bg-white rounded-2xl border border-slate-200 shadow-sm overflow-hidden">
                        <div class="p-4 border-b border-slate-100 flex flex-wrap items-center justify-between gap-2.5">
                            <span id="count-peserta" class="text-xs font-bold px-3 py-1 rounded-full bg-emerald-50 text-emerald-700 border border-emerald-100">0 Peserta</span>
                            <div class="flex flex-wrap items-center gap-2 w-full sm:w-auto">
                                <select id="filter-peserta-rayon" onchange="paginationState.peserta=1; renderPeserta()" class="text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-emerald-500 font-semibold">
                                    <option value="">Semua Ranting/Rayon</option>
                                </select>
                                <select id="filter-peserta-jk" onchange="paginationState.peserta=1; renderPeserta()" class="text-xs bg-slate-50 border border-slate-200 rounded-xl px-3 py-2 focus:outline-none focus:border-emerald-500 font-semibold">
                                    <option value="">Putra &amp; Putri</option>
                                    <option value="putra">Putra</option>
                                    <option value="putri">Putri</option>
                                </select>
                                <input type="text" id="cari-peserta" oninput="paginationState.peserta=1; renderPeserta()" placeholder="Cari nama, NIA, rayon..."
                                    class="flex-1 sm:w-48 text-xs px-3 py-2 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                            </div>
                        </div>
                        <div class="table-scroll">
                            <table class="w-full text-left border-collapse border-y border-slate-200">
                                <thead>
                                    <tr class="bg-slate-50 border-b border-slate-200 text-[11px] font-bold text-slate-600 uppercase tracking-wider">
                                        <th class="border-r border-slate-200 px-3 py-3 text-center w-12">No</th>
                                        <th class="border-r border-slate-200 px-4 py-3 text-center">Foto</th>
                                        <th class="border-r border-slate-200 px-4 py-3">Nama &amp; NIA</th>
                                        <th class="border-r border-slate-200 px-4 py-3">Ranting / Rayon</th>
                                        <th class="border-r border-slate-200 px-4 py-3">Gender, Usia &amp; BB</th>
                                        <th class="border-r border-slate-200 px-4 py-3 text-center">Aksi Cepat Raport</th>
                                        <th class="px-4 py-3 text-center">Kelola</th>
                                    </tr>
                                </thead>
                                <tbody id="tbody-peserta" class="divide-y divide-slate-200 text-xs">
                                    <tr><td colspan="7" class="text-center py-8 text-slate-400">Memuat data peserta...</td></tr>
                                </tbody>
                            </table>
                        </div>
                        <div id="pagination-peserta" class="hidden"></div>
                    </div>
                </div>
            </section>

            <!-- ==================== 2. MENU PENILAIAN (SUB MENU DINAMIS + KOLOM DINAMIS) ==================== -->
            <section id="sec-penilaian" class="raport-section hidden space-y-5">
                <!-- Header Penilaian -->
                <div class="bg-white rounded-2xl border border-slate-200 p-4 sm:p-5 shadow-sm space-y-4">
                    <div class="flex flex-wrap items-center justify-between gap-4">
                        <div class="flex items-center gap-3">
                            <div id="penilaian-icon-box" class="w-10 h-10 rounded-xl bg-emerald-100 text-emerald-600 flex items-center justify-center shrink-0">
                                <i id="penilaian-header-icon" class="fa-solid fa-dumbbell text-lg"></i>
                            </div>
                            <div>
                                <h2 id="penilaian-header-title" class="text-sm sm:text-base font-bold text-slate-800">Penilaian Fisik</h2>
                                <p class="text-[11px] text-slate-500">Kelola sub menu penilaian, atur kolom aspek, pilih peserta, dan simpan nilai</p>
                            </div>
                        </div>

                        <!-- Form Tambah Sub Menu Baru -->
                        <form onsubmit="tambahSubMenuPenilaian(event)" class="flex items-center gap-2 w-full sm:w-auto">
                            <input type="text" id="input-nama-submenu-baru" required placeholder="Nama sub menu (mis: Jurus)"
                                class="flex-1 sm:w-56 text-xs px-3.5 py-2.5 bg-slate-50 border border-slate-200 rounded-xl focus:outline-none focus:border-emerald-500">
                            <button type="submit"
                                class="inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white text-xs font-bold px-4 py-2.5 rounded-xl shadow-sm transition-colors cursor-pointer shrink-0">
                                <i class="fa-solid fa-folder-plus text-emerald-400"></i>
                                <span>Tambah Sub Menu</span>
                            </button>
                        </form>
                    </div>

                    <!-- Daftar Tab Sub Menu (Bisa Diklik untuk Pindah & Tombol Hapus Sub Menu) -->
