        // ==================== 3. MENU DAFTAR NILAI ====================
        function getFilteredDaftarNilai() {
            const filterRayon = (document.getElementById("filter-dn-rayon").value || "").toLowerCase();
            const filterJk = document.getElementById("filter-dn-jk").value;
            const kueri = (document.getElementById("cari-daftar-nilai").value || "").toLowerCase();

            return dataAnggota.filter(item => {
                const matchRayon = !filterRayon || (item.ranting_rayon || "").trim().toLowerCase() === filterRayon;
                const matchJk = !filterJk || klasifikasiGender(item.jenis_kelamin) === filterJk;
                const teks = `${item.nama_lengkap || ""} ${item.nia || ""} ${item.ranting_rayon || ""} ${item.kualifikasi_usia || ""}`.toLowerCase();
                return matchRayon && matchJk && teks.includes(kueri);
            });
        }

        function hitungNilaiAkhirSiswa(pesertaId) {
            const perSub = {};
            const terisi = [];
            raportSubmenus.forEach(sub => {
                const rata = hitungRataKategori(pesertaId, sub.id);
                perSub[sub.id] = rata;
                if (rata !== null) terisi.push(rata);
            });

            const nilaiAkhir = terisi.length > 0
                ? Math.round((terisi.reduce((s, v) => s + v, 0) / terisi.length) * 10) / 10
                : null;

            return { perSub, nilaiAkhir };
        }

