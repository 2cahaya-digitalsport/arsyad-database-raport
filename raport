        function pilihMenu(menu, subKategori = null, pesertaIdLangsung = null) {
            menuAktif = menu;
            if (subKategori && raportSubmenus.some(s => s.id === subKategori)) {
                subKategoriAktif = subKategori;
                paginationState.penilaian = 1;
            } else if (!raportSubmenus.some(s => s.id === subKategoriAktif) && raportSubmenus.length > 0) {
                subKategoriAktif = raportSubmenus[0].id;
            }

            document.querySelectorAll(".sidebar-btn").forEach(btn => {
                btn.classList.remove("sidebar-link-active");
                btn.classList.add("text-slate-300", "hover:bg-slate-800");
            });

            document.querySelectorAll(".raport-section").forEach(sec => sec.classList.add("hidden"));

            if (menu === "peserta") {
                document.getElementById("sec-peserta").classList.remove("hidden");
                document.getElementById("nav-peserta").classList.add("sidebar-link-active");
                document.getElementById("nav-peserta").classList.remove("text-slate-300", "hover:bg-slate-800");
                document.getElementById("topbar-title").innerText = "Data Peserta";
            } else if (menu === "penilaian") {
