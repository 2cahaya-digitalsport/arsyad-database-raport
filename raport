        // ==================== REALTIME FIREBASE LISTENERS ====================
        function aktifkanRealtime() {
            // 1. Data Anggota Terdaftar
            database.ref("administrasi_digital/anggota").on("value", snap => {
                const val = snap.val();
                const list = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                dataAnggota = list
                    .filter(item => {
                        const st = item.status || "Dikonfirmasi";
                        return st !== "Menunggu" && st !== "Ditolak";
                    })
                    .sort((a, b) => (a.nama_lengkap || "").localeCompare(b.nama_lengkap || ""));

                document.getElementById("badge-jml-peserta").innerText = dataAnggota.length;
                document.getElementById("count-peserta-header").innerText = `${dataAnggota.length} Peserta Terdaftar`;
                sinkronOpsiRayon();
                sinkronDropdownPesertaPenilaian();
                renderPeserta();
                renderTabelPenilaian();
                renderDaftarNilai();
            });

            // 2. Data Rayon
            database.ref("administrasi_digital/rayon").on("value", snap => {
                const val = snap.val();
                dataRayon = val ? Object.entries(val).map(([key, item]) => ({ ...item, id: item.id || key })) : [];
                sinkronOpsiRayon();
            });

            // 3. Sub Menu Penilaian Dinamis
            database.ref("administrasi_digital/raport_submenu").on("value", async snap => {
                const val = snap.val();
                if (!val) {
                    const initSnap = await database.ref("administrasi_digital/raport_submenu_init").once("value");
                    if (!initSnap.val()) {
                        await database.ref("administrasi_digital/raport_submenu").set(DEFAULT_SUBMENUS);
                        await database.ref("administrasi_digital/raport_submenu_init").set(true);
                        return;
                    }
                    raportSubmenus = [];
                } else if (Array.isArray(val)) {
                    raportSubmenus = val.filter(Boolean);
                } else if (typeof val === "object") {
                    raportSubmenus = Object.entries(val).map(([k, v]) => ({
                        id: v.id || k,
                        nama: v.nama || v
                    }));
                }

                if (raportSubmenus.length > 0 && !raportSubmenus.some(s => s.id === subKategoriAktif)) {
                    subKategoriAktif = raportSubmenus[0].id;
                }

                renderSidebarSubmenus();
                if (menuAktif === "penilaian") {
                    updateTampilanKategoriPenilaian();
                } else {
                    renderTabSubmenus();
                }
                renderDaftarNilai();
            });

            // 4. Kriteria / Kolom Penilaian Dinamis per Sub Menu
            database.ref("administrasi_digital/raport_kriteria").on("value", snap => {
                const val = snap.val();
                if (!val) {
                    database.ref("administrasi_digital/raport_kriteria").set(DEFAULT_KRITERIA);
                    return;
                }

                const parsed = {};
                Object.entries(val).forEach(([kat, rawKat]) => {
                    if (Array.isArray(rawKat)) {
                        parsed[kat] = rawKat.filter(Boolean);
                    } else if (rawKat && typeof rawKat === "object") {
                        parsed[kat] = Object.entries(rawKat).map(([k, v]) => ({
                            id: v.id || k,
                            nama: v.nama || v
                        }));
                    } else {
                        parsed[kat] = [];
                    }
                });
                raportKriteria = parsed;

                renderKelolaKolom();
                renderInputKolomPenilaian();
                renderTabelPenilaian();
                renderDaftarNilai();
            });

            // 5. Data Nilai Raport Siswa
            database.ref("administrasi_digital/raport_nilai").on("value", snap => {
                raportNilai = snap.val() || {};
                renderInputKolomPenilaian();
                renderTabelPenilaian();
                renderDaftarNilai();
            });
        }

        function sinkronOpsiRayon() {
            const setRayon = new Set();
            dataRayon.forEach(r => { if (r.nama_rayon_ranting) setRayon.add(r.nama_rayon_ranting.trim()); });
            dataAnggota.forEach(a => { if (a.ranting_rayon) setRayon.add(a.ranting_rayon.trim()); });
            const list = Array.from(setRayon).sort((a, b) => a.localeCompare(b));

            document.getElementById("list-opsi-rayon").innerHTML = list.map(r => `<option value="${esc(r)}">`).join("");

            ["filter-peserta-rayon", "filter-dn-rayon"].forEach(id => {
                const el = document.getElementById(id);
                if (!el) return;
                const current = el.value;
                el.innerHTML = `<option value="">Semua Ranting/Rayon</option>` + list.map(r => `<option value="${esc(r)}">${esc(r)}</option>`).join("");
                el.value = current;
            });
        }

