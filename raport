            const palette = [
                { icon: "fa-star", textColor: "text-amber-400", boxClass: "w-10 h-10 rounded-xl bg-amber-100 text-amber-600 flex items-center justify-center shrink-0" },
                { icon: "fa-shield-halved", textColor: "text-teal-400", boxClass: "w-10 h-10 rounded-xl bg-teal-100 text-teal-600 flex items-center justify-center shrink-0" },
                { icon: "fa-fire", textColor: "text-rose-400", boxClass: "w-10 h-10 rounded-xl bg-rose-100 text-rose-600 flex items-center justify-center shrink-0" }
            ];
            return palette[idx % palette.length];
