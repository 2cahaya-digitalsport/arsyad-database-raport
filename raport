            document.getElementById("nilai-peserta-id").value = "";
            onPilihPesertaPenilaian();
        }

        function hitungRataKategori(pesertaId, kategori) {
            const kolomList = raportKriteria[kategori] || [];
            const dataKat = raportNilai[pesertaId] && raportNilai[pesertaId][kategori];
            if (!dataKat || !dataKat.skor || kolomList.length === 0) return null;

            let total = 0, count = 0;
            kolomList.forEach(col => {
                const v = dataKat.skor[col.id];
                if (v !== undefined && v !== null && v !== "" && !isNaN(Number(v))) {
                    total += Number(v);
                    count++;
                }
            });
            if (count === 0) return null;
            return Math.round((total / count) * 10) / 10;
        }

