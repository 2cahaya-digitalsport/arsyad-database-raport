        async function simpanEditPeserta(event) {
            event.preventDefault();
            const id = document.getElementById("peserta-id").value;
            if (!id) return;

            const existing = dataAnggota.find(a => String(a.id) === String(id));
            if (!existing) return;

            const foto = await prosesFileFoto("peserta-foto", existing.foto || "");
            const bbInput = document.getElementById("peserta-bb").value.trim();

            const payload = {
                ...existing,
                id: id,
                nama_lengkap: document.getElementById("peserta-nama").value.trim(),
                nia: document.getElementById("peserta-nia").value.trim(),
                ranting_rayon: document.getElementById("peserta-rayon").value.trim(),
                jenis_kelamin: document.getElementById("peserta-jk").value,
                kualifikasi_usia: document.getElementById("peserta-usia").value,
                tanggal_lahir: document.getElementById("peserta-tgl").value,
                berat_badan: bbInput !== "" ? Number(bbInput) : "",
                whatsapp: document.getElementById("peserta-wa").value.trim(),
                foto: foto,
                status: existing.status || "Dikonfirmasi"
            };

            try {
                const updates = {};
                updates[`administrasi_digital/anggota/${id}`] = payload;
                if (raportNilai[id]) {
                    updates[`administrasi_digital/raport_nilai/${id}/berat_badan`] = payload.berat_badan;
                }
                await database.ref().update(updates);
                tampilkanNotif("Data peserta diperbarui.");
                tutupFormEditPeserta();
            } catch (e) {
                tampilkanNotif("Gagal menyimpan perubahan: " + e.message, true);
            }
        }

        async function hapusPeserta(id, nama) {
            if (!confirm(`Yakin ingin menghapus peserta "${nama || "ini"}"?`)) return;
            try {
                await database.ref(`administrasi_digital/anggota/${id}`).remove();
                await database.ref(`administrasi_digital/raport_nilai/${id}`).remove();
                tampilkanNotif("Peserta berhasil dihapus.");
            } catch (e) {
                tampilkanNotif("Gagal menghapus peserta: " + e.message, true);
            }
        }

