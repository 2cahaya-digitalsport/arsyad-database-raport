        function hitungPreviewRataInput() {
            const inputs = document.querySelectorAll(".input-skor-dinamis");
            let total = 0, count = 0;
            inputs.forEach(inp => {
                if (inp.value !== "") {
                    const n = parseFloat(inp.value);
                    if (!isNaN(n)) {
                        total += Math.min(100, Math.max(0, n));
                        count++;
                    }
                }
            });
            const rata = count > 0 ? Math.round((total / count) * 10) / 10 : 0;
            document.getElementById("preview-rata-kategori").innerText = `Rata-rata: ${rata}`;
        }

        async function simpanPenilaian(event) {
            event.preventDefault();
            const pesertaId = document.getElementById("nilai-peserta-id").value;
            if (!pesertaId) {
                tampilkanNotif("Pilih nama peserta terlebih dahulu.", true);
                return;
            }

            const kolomList = raportKriteria[subKategoriAktif] || [];
            if (kolomList.length === 0) {
                tampilkanNotif("Tambahkan minimal 1 kolom penilaian.", true);
                return;
            }

            const skorMap = {};
            document.querySelectorAll(".input-skor-dinamis").forEach(inp => {
                const kolId = inp.dataset.kolomId;
                const val = Math.min(100, Math.max(0, Number(inp.value || 0)));
                skorMap[kolId] = val;
            });

            const bbValRaw = document.getElementById("nilai-bb").value.trim();
            const bbVal = bbValRaw !== "" ? Number(bbValRaw) : "";

            const payload = {
                skor: skorMap,
                catatan: document.getElementById("nilai-catatan").value.trim(),
                updated_at: new Date().toISOString()
            };

            try {
                const updates = {};
                updates[`administrasi_digital/raport_nilai/${pesertaId}/${subKategoriAktif}`] = payload;
                updates[`administrasi_digital/raport_nilai/${pesertaId}/berat_badan`] = bbVal;
                updates[`administrasi_digital/anggota/${pesertaId}/berat_badan`] = bbVal;
                await database.ref().update(updates);

                const peserta = dataAnggota.find(a => String(a.id) === String(pesertaId));
                const subObj = raportSubmenus.find(s => s.id === subKategoriAktif);
                tampilkanNotif(`Nilai ${subObj ? subObj.nama : subKategoriAktif} untuk ${peserta ? peserta.nama_lengkap : "peserta"} disimpan.`);
            } catch (e) {
                tampilkanNotif("Gagal menyimpan penilaian: " + e.message, true);
            }
        }

