                        <td class="border border-slate-300 px-3 py-3 text-center whitespace-nowrap">
                            <button type="button" onclick='cetakRaportSatuSiswa(${safeJsonAttr(item.id)})'
                                class="inline-flex items-center gap-1.5 bg-slate-900 hover:bg-slate-800 text-white text-[11px] font-bold px-3 py-2 rounded-lg shadow-sm transition-colors cursor-pointer">
                                <i class="fa-solid fa-file-pdf text-rose-400"></i>
                                <span>Cetak PDF</span>
                            </button>
                        </td>
                    </tr>
                `;
            }).join("");
        }

        // ==================== CETAK PDF RAPORT RAPI PER SISWA (1 HALAMAN PENUH / TANPA TERPOTONG) ====================
        function buatHtmlSatuRaport(item) {
            const periode = (document.getElementById("raport-periode").value || "Semester Ganjil 2026").trim();
            const namaPembina = (document.getElementById("raport-pembina").value || "Ketua Dangsanak Sport Club").trim();
            const namaPelatih = (document.getElementById("raport-pelatih").value || "Tim Pelatih Dangsanak Sport Club").trim();
            const tanggalCetak = new Date().toLocaleDateString("id-ID", { day: "2-digit", month: "long", year: "numeric" });

            const { perSub, nilaiAkhir } = hitungNilaiAkhirSiswa(item.id);
            const pred = getPredikat(nilaiAkhir);
            const umur = hitungUmurTahun(item.tanggal_lahir);
            const kategoriGender = formatKategoriGender(item);
            const bbStr = formatBeratBadan(getBeratBadanSiswa(item));

            const fotoHtml = (item.foto && !item.foto.includes("via.placeholder.com"))
                ? `<img src="${esc(item.foto)}" alt="Foto" class="raport-foto">`
                : `<div class="raport-inisial">${esc(getInisial(item.nama_lengkap))}</div>`;

            function renderTabelKategori(judul, katKey, rataKat) {
                const kolomList = raportKriteria[katKey] || [];
                const dataKat = (raportNilai[item.id] && raportNilai[item.id][katKey]) || {};
                const skorMap = dataKat.skor || {};

                const rows = kolomList.length === 0
                    ? `<tr><td colspan="4" style="text-align:center; color:#94a3b8;">Belum ada aspek penilaian</td></tr>`
                    : kolomList.map((col, i) => {
                        const skor = skorMap[col.id];
                        const adaSkor = skor !== undefined && skor !== null && skor !== "" && !isNaN(Number(skor));
                        const predCol = getPredikat(adaSkor ? Number(skor) : null);
                        return `
                            <tr>
                                <td style="width:7%; text-align:center;">${i + 1}</td>
                                <td style="width:55%;">${esc(col.nama)}</td>
                                <td style="width:18%; text-align:center; font-weight:700;">${adaSkor ? esc(skor) : "-"}</td>
                                <td style="width:20%; text-align:center;">${adaSkor ? esc(predCol.kode + " - " + predCol.label) : "-"}</td>
                            </tr>
                        `;
                    }).join("");

                return `
                    <div>
                        <div class="raport-section-title">
                            <span>${esc(judul)}</span>
                            <span>Rata-rata: ${rataKat !== null ? rataKat : "-"}</span>
                        </div>
                        <table class="raport-table">
                            <thead>
                                <tr>
                                    <th style="width:7%; text-align:center;">No</th>
                                    <th style="width:55%;">Aspek Penilaian</th>
                                    <th style="width:18%; text-align:center;">Nilai</th>
                                    <th style="width:20%; text-align:center;">Predikat</th>
                                </tr>
                            </thead>
                            <tbody>
                                ${rows}
                            </tbody>
                        </table>
                    </div>
                `;
            }

            const bagianTabelPenilaian = raportSubmenus.map((sub, idx) => {
                const huruf = String.fromCharCode(65 + idx);
                return renderTabelKategori(`${huruf}. PENILAIAN ${sub.nama.toUpperCase()}`, sub.id, perSub[sub.id]);
            }).join("");

            const catatanList = raportSubmenus.map(sub => {
                const cat = raportNilai[item.id]?.[sub.id]?.catatan || "";
                return cat ? `<b>${esc(sub.nama)}:</b> ${esc(cat)}` : "";
            }).filter(Boolean);

            const gabunganCatatan = catatanList.join("<br>") || "Pertahankan kedisiplinan latihan dan terus tingkatkan kemampuan di seluruh aspek penilaian.";

            return `
                <div class="raport-page">
                    <!-- KOP RAPORT -->
                    <div class="raport-kop">
                        <div>
                            <div style="font-size:13pt; font-weight:900; color:#065f46; text-transform:uppercase; letter-spacing:0.03em;">
                                DANGSANAK SPORT CLUB
                            </div>
                            <div style="font-size:10pt; font-weight:700; color:#0f172a; margin-top:1px;">
                                RAPORT EVALUASI HASIL LATIHAN ANGGOTA
                            </div>
                        </div>
                        <div style="text-align:right; font-size:8pt; color:#475569;">
                            <div>Periode: <b>${esc(periode)}</b></div>
                            <div>Tanggal: <b>${esc(tanggalCetak)}</b></div>
                        </div>
                    </div>

                    <!-- IDENTITAS PESERTA -->
                    <div class="raport-identitas">
                        ${fotoHtml}
                        <div class="raport-bio-grid">
                            <div>Nama Lengkap : <b>${esc(item.nama_lengkap || "-")}</b></div>
                            <div>Ranting / Rayon : <b>${esc(item.ranting_rayon || "-")}</b></div>
                            <div>Nomor Induk (NIA) : <b>${esc(item.nia || "-")}</b></div>
                            <div>Kategori &amp; Gender : <b>${esc(kategoriGender)}</b></div>
                            <div>Usia : <b>${umur !== null ? umur + " Tahun" : (item.kualifikasi_usia || "-")}</b></div>
                            <div>Berat Badan : <b>${esc(bbStr)}</b></div>
                            <div>No. WhatsApp : <b>${esc(item.whatsapp || "-")}</b></div>
                            <div>Status Anggota : <b>Aktif / Terdaftar</b></div>
                        </div>
                    </div>

                    <!-- TABEL PENILAIAN DINAMIS -->
                    ${bagianTabelPenilaian}

                    <!-- RINGKASAN NILAI AKHIR & CATATAN -->
                    <div class="raport-summary">
                        <div class="raport-nilai-box">
                            <div style="font-size:7.5pt; font-weight:700; color:#065f46; text-transform:uppercase;">Nilai Akhir Raport</div>
                            <div style="font-size:20pt; font-weight:900; color:#047857; line-height:1.15; margin:2px 0;">
                                ${nilaiAkhir !== null ? nilaiAkhir : "-"}
                            </div>
                            <div style="font-size:8pt; font-weight:700; color:#0f172a;">
                                ${pred.kode !== "-" ? `Predikat ${pred.kode} (${pred.label})` : "Belum Dinilai"}
                            </div>
                        </div>
                        <div class="raport-catatan-box">
                            <div style="font-weight:700; color:#065f46; text-transform:uppercase; font-size:7.5pt; margin-bottom:3px;">
                                Catatan &amp; Evaluasi Pelatih:
                            </div>
                            <div style="color:#334155; line-height:1.4;">
                                ${gabunganCatatan}
                            </div>
                        </div>
                    </div>

                    <!-- TANDA TANGAN -->
                    <div class="raport-ttd">
                        <div style="width:42%;">
                            <div>Mengetahui,</div>
                            <div style="font-weight:700;">Ketua / Pembina</div>
                            <div style="height:42px;"></div>
                            <div style="font-weight:700; text-decoration:underline;">${esc(namaPembina)}</div>
                        </div>
                        <div style="width:42%;">
                            <div>${esc(tanggalCetak)}</div>
                            <div style="font-weight:700;">Pelatih Penilai</div>
                            <div style="height:42px;"></div>
                            <div style="font-weight:700; text-decoration:underline;">${esc(namaPelatih)}</div>
                        </div>
                    </div>
                </div>
            `;
        }

        function cetakRaportSatuSiswa(pesertaId) {
            const siswa = dataAnggota.find(a => String(a.id) === String(pesertaId));
            if (!siswa) {
                tampilkanNotif("Data siswa tidak ditemukan.", true);
                return;
            }
            document.getElementById("print-area").innerHTML = buatHtmlSatuRaport(siswa);
            setTimeout(() => window.print(), 150);
        }

        function cetakSemuaRaportPDF() {
            const list = getFilteredDaftarNilai();
            if (list.length === 0) {
                tampilkanNotif("Tidak ada data anggota untuk dicetak.", true);
                return;
            }
            document.getElementById("print-area").innerHTML = list.map(siswa => buatHtmlSatuRaport(siswa)).join("");
            setTimeout(() => window.print(), 200);
        }

        // Preview Foto
        function bukaPreviewFoto(src, caption) {
            document.getElementById("preview-img").src = src;
            document.getElementById("preview-caption").innerText = caption || "";
            document.getElementById("modal-preview").classList.remove("hidden");
        }

        function tutupPreviewFoto() {
            document.getElementById("modal-preview").classList.add("hidden");
        }

        // Inisialisasi Halaman
        window.addEventListener("DOMContentLoaded", () => {
            terapkanStateSidebar();
            renderSidebarSubmenus();
            pilihMenu("peserta");
            aktifkanRealtime();
        });
    </script>
</body>
</html>
