                teknik: { icon: "fa-hand-fist", textColor: "text-sky-400", boxClass: "w-10 h-10 rounded-xl bg-sky-100 text-sky-600 flex items-center justify-center shrink-0" },
                taktik: { icon: "fa-chess-knight", textColor: "text-purple-400", boxClass: "w-10 h-10 rounded-xl bg-purple-100 text-purple-600 flex items-center justify-center shrink-0" }
